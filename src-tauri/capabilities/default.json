{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs, a folder picker, and file access for the notes library",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:read-all",
    "fs:write-all",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME" }, { "path": "$HOME/**" }, { "path": "$DOCUMENT" }, { "path": "$DOCUMENT/**" }]
    }
  ]
}
