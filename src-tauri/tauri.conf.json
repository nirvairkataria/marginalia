{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Marginalia",
  "version": "0.1.0",
  "identifier": "dev.marginalia.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Marginalia",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "shortDescription": "Scientific notes with ink"
  }
}
